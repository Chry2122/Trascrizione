OPENAI_API_KEY=your_openai_api_key_here

# Optional: speech-to-text model. gpt-4o-mini-transcribe (default, cheaper),
# gpt-4o-transcribe or whisper-1.
# TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional: folder for uploads, chunks and transcripts. On Railway/Render/Fly mount a
# persistent volume and point this to it (the Dockerfile uses /data). Default: system temp dir.
# APP_DATA_DIR=/data

# Optional: path of an ffmpeg binary (the Dockerfile sets /usr/bin/ffmpeg).
# FFMPEG_PATH=
